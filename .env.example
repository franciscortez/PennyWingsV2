# Local Supabase is run by the Supabase CLI (`npm run db:start`).
# Ports, auth settings, migrations and seeding live in supabase/config.toml.
# Run `npx supabase status` to print the local URL and keys.

# Supabase Client Credentials
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Admin / Service Role Key
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI / linked (remote) DB operations
SUPABASE_DB_PASSWORD=

# OpenRouter AI Assistant (Edge Function secrets)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# SMTP Configuration (Edge Function secrets)
SMTP_EMAIL=
SMTP_PASSWORD=
CRON_SECRET=
