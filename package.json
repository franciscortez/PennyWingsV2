{
  "name": "pennywingsv2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "db:fetch": "npx supabase migration fetch --linked",
    "db:baseline:repair": "npx supabase migration repair --linked --status reverted 20260317071150 20260318073854 20260318074619 20260318080053 20260318111247 20260319071947 20260319072524 20260319083401 20260320121719 20260320121736 20260321021831 20260321113330 20260321113347 20260321113356 20260321113406 20260321113719 20260321115431 20260404135454 20260410122659 202607090002 202607090003 202607090004",
    "db:lint": "npx supabase db lint --linked",
    "db:migrations": "npx supabase migration list --linked",
    "db:push": "npx supabase db push --linked",
    "db:push:dry-run": "npx supabase db push --linked --dry-run",
    "db:types": "npx supabase gen types typescript --linked --schema public > src/lib/database.types.generated.ts && node -e \"require('node:fs').renameSync('src/lib/database.types.generated.ts','src/lib/database.types.ts')\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.1.0",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
