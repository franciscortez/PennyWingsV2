{
  "name": "pennywingsv2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "db:fetch": "npx supabase migration fetch --linked",
    "db:lint": "npx supabase db lint --linked",
    "db:migrations": "npx supabase migration list --linked",
    "db:push": "npx supabase db push --linked",
    "db:push:dry-run": "npx supabase db push --linked --dry-run",
    "db:types": "npx supabase gen types typescript --linked --schema public > src/lib/database.types.generated.ts && node -e \"require('node:fs').renameSync('src/lib/database.types.generated.ts','src/lib/database.types.ts')\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "npm run test && npm run test:e2e",
    "test:db": "npx supabase test db",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.1.0",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "supabase": "^2.109.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
